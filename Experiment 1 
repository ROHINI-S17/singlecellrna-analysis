        "# ============================================================\n",
        "# EXPERIMENT 1: GENERATE AND EXPLORE scRNA-seq DATA\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Reproducibility\n",
        "np.random.seed(42)\n",
        "\n",
        "# Number of cells and genes\n",
        "n_cells = 200\n",
        "n_genes = 50\n",
        "\n",
        "# Gene names\n",
        "genes = [f\"Gene_{i+1}\" for i in range(n_genes)]\n",
        "\n",
        "# Cell names\n",
        "cells = [f\"Cell_{i+1}\" for i in range(n_cells)]\n",
        "\n",
        "# Generate synthetic gene expression data\n",
        "data = np.random.poisson(\n",
        "    lam=5,\n",
        "    size=(n_cells, n_genes)\n",
        ")\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(\n",
        "    data,\n",
        "    index=cells,\n",
        "    columns=genes\n",
        ")\n",
        "\n",
        "print(\"Single-Cell RNA-seq Dataset\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "print(\"\\nDataset Shape:\")\n",
        "print(df.shape)\n",
        "\n",
        "print(\"\\nNumber of Cells:\", df.shape[0])\n",
        "print(\"Number of Genes:\", df.shape[1])\n",
        "\n",
        "print(\"\\nFirst 5 Cells:\")\n",
        "display(df.head())\n",
        "\n",
        "print(\"\\nBasic Statistics:\")\n",
        "display(df.describe())\n",
        "\n",
        "print(\"\\nTotal Missing Values:\")\n",
        "print(df.isnull().sum().sum())\n",
        "\n",
        "# Heatmap of first 20 cells and 20 genes\n",
        "plt.figure(figsize=(12, 7))\n",
        "\n",
        "sns.heatmap(\n",
        "    df.iloc[:20, :20],\n",
        "    cmap=\"viridis\"\n",
        ")\n",
        "\n",
        "plt.title(\"Gene Expression Heatmap\")\n",
        "plt.xlabel(\"Genes\")\n",
        "plt.ylabel(\"Cells\")\n",
        "\n",
        "plt.show()"
      ]
    }
