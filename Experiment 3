        "# ============================================================\n",
        "# EXPERIMENT 3: NORMALIZATION AND GENE EXPRESSION ANALYSIS\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate sample data\n",
        "n_cells = 200\n",
        "n_genes = 50\n",
        "\n",
        "genes = [f\"Gene_{i+1}\" for i in range(n_genes)]\n",
        "cells = [f\"Cell_{i+1}\" for i in range(n_cells)]\n",
        "\n",
        "data = np.random.poisson(\n",
        "    lam=5,\n",
        "    size=(n_cells, n_genes)\n",
        ")\n",
        "\n",
        "df = pd.DataFrame(\n",
        "    data,\n",
        "    index=cells,\n",
        "    columns=genes\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# NORMALIZATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Total counts in each cell\n",
        "cell_totals = df.sum(axis=1)\n",
        "\n",
        "# Normalize each cell to 10,000 counts\n",
        "normalized_df = df.div(\n",
        "    cell_totals,\n",
        "    axis=0\n",
        ") * 10000\n",
        "\n",
        "# Log transformation\n",
        "log_df = np.log1p(normalized_df)\n",
        "\n",
        "print(\"NORMALIZATION\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "print(\"\\nOriginal Data:\")\n",
        "display(df.head())\n",
        "\n",
        "print(\"\\nNormalized Data:\")\n",
        "display(normalized_df.head())\n",
        "\n",
        "print(\"\\nLog-Transformed Data:\")\n",
        "display(log_df.head())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIND HIGHLY EXPRESSED GENES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "gene_average = log_df.mean(axis=0)\n",
        "\n",
        "top_genes = gene_average.sort_values(\n",
        "    ascending=False\n",
        ").head(10)\n",
        "\n",
        "print(\"\\nTop 10 Highly Expressed Genes:\")\n",
        "display(top_genes)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# VISUALIZATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "sns.barplot(\n",
        "    x=top_genes.values,\n",
        "    y=top_genes.index\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Top 10 Highly Expressed Genes\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\n",
        "    \"Average Normalized Expression\"\n",
        ")\n",
        "\n",
        "plt.ylabel(\n",
        "    \"Gene\"\n",
        ")\n",
        "\n",
        "plt.show()"
      ]
    }
  ]
