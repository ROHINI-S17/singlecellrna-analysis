        "# ============================================================\n",
        "# EXPERIMENT 5: CELL CLUSTERING AND MARKER GENE ANALYSIS\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.cluster import KMeans\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate sample data\n",
        "n_cells = 200\n",
        "n_genes = 50\n",
        "\n",
        "genes = [f\"Gene_{i+1}\" for i in range(n_genes)]\n",
        "cells = [f\"Cell_{i+1}\" for i in range(n_cells)]\n",
        "\n",
        "data = np.random.poisson(\n",
        "    lam=5,\n",
        "    size=(n_cells, n_genes)\n",
        ")\n",
        "\n",
        "df = pd.DataFrame(\n",
        "    data,\n",
        "    index=cells,\n",
        "    columns=genes\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STANDARDIZATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_scaled = scaler.fit_transform(df)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# PCA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "pca = PCA(\n",
        "    n_components=10\n",
        ")\n",
        "\n",
        "X_pca = pca.fit_transform(\n",
        "    X_scaled\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# K-MEANS CLUSTERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "kmeans = KMeans(\n",
        "    n_clusters=4,\n",
        "    random_state=42,\n",
        "    n_init=10\n",
        ")\n",
        "\n",
        "clusters = kmeans.fit_predict(\n",
        "    X_pca\n",
        ")\n",
        "\n",
        "# Add cluster information\n",
        "df[\"Cluster\"] = clusters\n",
        "\n",
        "print(\"Number of clusters:\", 4)\n",
        "\n",
        "print(\"\\nCells in each cluster:\")\n",
        "\n",
        "print(\n",
        "    df[\"Cluster\"]\n",
        "    .value_counts()\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# VISUALIZE CLUSTERS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "sns.scatterplot(\n",
        "    x=X_pca[:, 0],\n",
        "    y=X_pca[:, 1],\n",
        "    hue=clusters,\n",
        "    palette=\"tab10\",\n",
        "    s=50\n",
        ")\n",
        "\n",
        "plt.xlabel(\"PC1\")\n",
        "plt.ylabel(\"PC2\")\n",
        "\n",
        "plt.title(\n",
        "    \"Single-Cell Clustering using K-Means\"\n",
        ")\n",
        "\n",
        "plt.legend(\n",
        "    title=\"Cluster\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIND MARKER GENES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "expression_data = df.drop(\n",
        "    columns=\"Cluster\"\n",
        ")\n",
        "\n",
        "for cluster in sorted(\n",
        "    df[\"Cluster\"].unique()\n",
        "):\n",
        "\n",
        "    # Select cells belonging to cluster\n",
        "    cluster_cells = (\n",
        "        df[\"Cluster\"] == cluster\n",
        "    )\n",
        "\n",
        "    # Calculate mean expression\n",
        "    mean_expression = (\n",
        "        expression_data[\n",
        "            cluster_cells\n",
        "        ].mean()\n",
        "    )\n",
        "\n",
        "    # Top genes\n",
        "    top_genes = mean_expression.sort_values(\n",
        "        ascending=False\n",
        "    ).head(5)\n",
        "\n",
        "    print(\n",
        "        f\"\\nTop Marker Genes - Cluster {cluster}\"\n",
        "    )\n",
        "\n",
        "    print(top_genes)"
      ]
